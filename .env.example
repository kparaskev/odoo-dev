# Remote Odoo server connection
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_database
ODOO_USERNAME=admin
ODOO_PASSWORD=your_password

# Local source paths
ODOO_SOURCE_PATH=C:/path/to/odoo
ODOO_ENTERPRISE_PATH=C:/path/to/enterprise
# Comma-separated list of custom addon paths (leave empty if none)
ODOO_CUSTOM_ADDON_PATHS=C:/path/to/custom_addons1,C:/path/to/custom_addons2

# Directory where analyzer caches (JSON data files) are stored
DATA_PATH=./data
